---

<Layout title="Proyectos">
  <Header currentPage="proyectos" />

  <main class="projects-page">
    <section class="projects-hero">
      <h1>Proyectos</h1>
    </section>

    <section class="projects-grid">
      {projects.map((project) => (
        <a href={`/proyectos/${project.slug}`} class="project-card">
          <div class="project-image">
            <img src={project.image} alt={project.title} />
          </div>
          <div class="project-info">
            <span class="project-category">{project.category}</span>
            <h2 class="project-title">{project.title}</h2>
          </div>
        </a>
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .projects-page {
    padding-top: 80px;
  }

  .projects-hero {
    padding: 80px var(--spacing-margin-desktop);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .projects-hero h1 {
    font-size: var(--text-headline-xl);
    text-transform: uppercase;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-gutter);
    padding: var(--spacing-gutter);
  }

  .project-card {
    display: block;
    cursor: pointer;
  }

  .project-image {
    overflow: hidden;
    aspect-ratio: 4/3;
    margin-bottom: 24px;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: var(--text-label-mono);
    text-transform: uppercase;
    color: var(--color-primary);
    display: block;
    margin-bottom: 8px;
  }

  .project-title {
    font-size: var(--text-headline-md);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .projects-hero {
      padding: 60px var(--spacing-margin-mobile);
    }

    .projects-hero h1 {
      font-size: 48px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      padding: var(--spacing-margin-mobile);
    }
  }
</style>