<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title">
      Cada espacio tiene una <span class="highlight">respuesta</span>.
    </h1>
    <p class="hero-description">
      Abordamos la arquitectura desde la precisión técnica y la claridad conceptual para transformar el entorno habitado en experiencias significativas.
    </p>
    <a href="/proyectos" class="hero-btn">VER PROYECTOS</a>
  </div>
  <div class="hero-image">
    <img
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuB9ghBh0MnOTJI6i8S50FgU0RqcRiaVQ7H3T1vPWohMOYMnSYe5n3jtDqgTDnW_Jw94cRSRBrWaBX923rbYoAOSBxe9zsBhWcKzNsIPwvb7I-Er59LlftS4yloZ21Ko_s_IKyY7cnMWE_6JF1a7zqEKCyhLV6IhoAlFjFmiVgoX-KEjicXTLhA2DrlAGUMwtTo97n9kbHbIZqN0ptrZMc92Vg8CjCaToZDC1I2S5B4ibTzT01PdBJ08h8rarhYO-_09Ms4kn4u2ow4"
      alt="Contemporary Architecture"
    />
  </div>
</section>

<style>
  .hero {
    display: flex;
    margin-top: 80px;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .hero-content {
    flex: 1;
    padding: 80px var(--spacing-margin-desktop);
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-title {
    font-size: var(--text-headline-xl);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    max-width: 600px;
    margin-bottom: 32px;
  }

  .highlight {
    color: var(--color-primary);
  }

  .hero-description {
    font-size: var(--text-body-lg);
    color: var(--color-on-surface-variant);
    max-width: 450px;
    margin-bottom: 48px;
  }

  .hero-btn {
    display: inline-block;
    background-color: var(--color-on-background);
    color: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-label-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 20px 48px;
    transition: background-color 0.3s ease;
    width: fit-content;
  }

  .hero-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .hero-image {
    flex: 1;
    position: relative;
    border-left: 1px solid var(--color-outline-variant);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
    }

    .hero-content {
      padding: 60px var(--spacing-margin-mobile);
    }

    .hero-title {
      font-size: 48px;
    }

    .hero-image {
      height: 400px;
      border-left: none;
      border-top: 1px solid var(--color-outline-variant);
    }
  }
</style>
