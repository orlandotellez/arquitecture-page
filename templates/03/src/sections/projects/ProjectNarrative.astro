---
interface Props {
  quote: string;
  paragraphs: string[];
}

const { quote, paragraphs } = Astro.props;
---

<section class="narrative">
  <div class="narrative-container">
    <div class="quote-wrapper">
      <h2 class="quote">
        {quote}
      </h2>
    </div>

    <div class="paragraphs">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .narrative {
    padding: 128px var(--spacing-margin-desktop);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--spacing-gutter);
  }

  .narrative-container {
    grid-column: 2 / span 10;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: var(--spacing-gutter);
  }

  .quote-wrapper {
    grid-column: span 10;
  }

  .quote {
    font-size: var(--text-headline-lg);
    font-style: italic;
    line-height: 1.4;
    margin-bottom: 48px;
  }

  .quote :global(span) {
    color: var(--color-primary);
    font-style: normal;
  }

  .paragraphs {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .paragraphs p {
    font-size: var(--text-body-md);
    color: var(--color-on-surface);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .narrative {
      padding: 80px var(--spacing-margin-mobile);
    }

    .narrative-container {
      display: flex;
      flex-direction: column;
    }

    .paragraphs {
      grid-column: span 10;
    }
  }
</style>