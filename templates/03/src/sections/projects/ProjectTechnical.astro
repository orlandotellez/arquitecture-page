---
interface TechnicalItem {
  label: string;
  value: string;
}

interface Props {
  items: TechnicalItem[];
}

const { items } = Astro.props;
---

<section class="technical">
  <div class="technical-container">
    {items.map((item) => (
      <div class="technical-item">
        <span class="technical-label">{item.label}</span>
        <p class="technical-value">{item.value}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .technical {
    padding: 128px var(--spacing-margin-desktop);
    background-color: var(--color-on-background);
    color: var(--color-surface);
  }

  .technical-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-gutter);
    border-top: 1px solid var(--color-secondary);
    padding-top: 32px;
  }

  .technical-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-label-mono);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .technical-value {
    font-size: var(--text-body-md);
    opacity: 0.8;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .technical-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .technical {
      padding: 80px var(--spacing-margin-mobile);
    }

    .technical-container {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }
  }
</style>