---
interface Drawing {
  src: string;
  alt: string;
}

interface Props {
  drawings: Drawing[];
}

const { drawings } = Astro.props;
---

<section class="drawings">
  <div class="drawings-header">
    <h3 class="drawings-title">Planimetry &amp; Sketches</h3>
  </div>

  <div class="drawings-scroll">
    {drawings.map((drawing) => (
      <div class="drawing-card">
        <img src={drawing.src} alt={drawing.alt} />
      </div>
    ))}
  </div>
</section>

<style>
  .drawings {
    padding: 128px 0;
    background-color: var(--color-surface-container-low);
    overflow: hidden;
  }

  .drawings-header {
    padding: 0 var(--spacing-margin-desktop);
    margin-bottom: 32px;
  }

  .drawings-title {
    font-family: var(--font-mono);
    font-size: var(--text-label-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
  }

  .drawings-scroll {
    display: flex;
    gap: 64px;
    overflow-x: auto;
    padding: 0 var(--spacing-margin-desktop);
    scrollbar-width: none;
  }

  .drawings-scroll::-webkit-scrollbar {
    display: none;
  }

  .drawing-card {
    flex-shrink: 0;
    width: 600px;
    aspect-ratio: 4/3;
    background: white;
    border: 1px solid var(--color-outline-variant);
    padding: 32px;
  }

  .drawing-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .drawings {
      padding: 80px 0;
    }

    .drawings-header {
      padding: 0 var(--spacing-margin-mobile);
    }

    .drawings-scroll {
      padding: 0 var(--spacing-margin-mobile);
    }
  }
</style>