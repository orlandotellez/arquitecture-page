---
import CardFeaturedProject from '../../components/CardFeaturedProject.astro';
import image_1 from '../../../public/images/proyecto-1.jpeg';
import image_2 from '../../../public/images/proyecto-2.jpeg';

const projects = [
 {
  img: image_1.src,
  place: "Villa Horizonte",
  details: "Residencial — Mallorca, España"
  },
{
  img: image_2.src,
  place: "Centro cultural Norte",
  details: "Publico — Bilbao, España",
  },
{
  img: image_1.src,
  place: "Torre Prisma",
  details: "Comercial — Ciudad de Mexico"
  },

 ]
---

<section class="projects-section">
  <div class="projects-inner">
    <div class="projects-header">
      <span class="overline">Portafolio</span>
      <h3>Proyectos destacados</h3>
    </div>
    <div class="projects-grid">
      {
        projects.map((project) => (
        <CardFeaturedProject
        img={project.img}
        place={project.place}
        details={project.details}
        />
        ))
      }
    </div>
    <div class="projects-actions">
      <a href="/proyectos" class="btn-link">
        Ver todos los proyectos
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    background-color: var(--color-bg-light);
  }

  .projects-inner {
    max-width: var(--max-width);
    margin: auto;
    padding: 100px 40px;
  }

  .projects-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .overline {
    display: inline-block;
    font-family: 'Inter Variable', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  h3 {
    font-family: 'Playfair Display Variable', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
    margin-bottom: 48px;
  }

  .projects-actions {
    text-align: center;
  }

  .btn-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter Variable', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: var(--transition);
  }

  .btn-link .arrow {
    transition: transform 0.3s ease;
  }

  .btn-link:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .projects-inner {
      padding: 60px 20px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    h3 {
      font-size: 1.6rem;
    }
  }
</style>
