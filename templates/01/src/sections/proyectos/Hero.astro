---
import Section from '../../components/Section.astro';
---

<Section>
  <article class="hero-content">
    <span class="overline">Nuestro trabajo</span>
    <h2 class="title">Proyectos <span class="accent">seleccionados</span></h2>
    <p class="subtitle">
      Una selección de nuestro trabajo más reciente, donde la visión se encuentra con la realidad.
    </p>
  </article>
</Section>

<style>
  .hero-content {
    width: 100%;
    max-width: 800px;
    margin: auto;
    text-align: center;
    padding: 80px 0;
  }

  .overline {
    display: inline-block;
    font-family: 'Inter Variable', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .title {
    font-family: 'Playfair Display Variable', serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.15;
    margin-bottom: 24px;
  }

  .accent {
    color: var(--color-accent);
  }

  .subtitle {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .title {
      font-size: 2.2rem;
    }

    .hero-content {
      padding: 60px 0;
    }
  }
</style>
