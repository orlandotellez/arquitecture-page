---
import GoogleMap from '../../components/GoogleMap.astro';
import cellphone from '../../assets/cellphone.svg';
import location from '../../assets/location.svg';
import mail from '../../assets/mail.svg';
import FormContact from '../../components/FormContact.astro';
---

<section class="contact-section">
  <div class="contact-inner">
    <div class="contact-text">
      <span class="overline">Información</span>
      <h3>Estamos aquí para ti</h3>
      <ul>
          <li>
            <span class="icon-wrapper">
              <img src={location.src} alt="ubicación">
            </span>
            <div>
              <h6>Visítanos</h6>
              <p>Calle de la Arquitectura 123, 28001 Madrid, España</p>
            </div>
          </li>

          <li>
            <span class="icon-wrapper">
              <img src={mail.src} alt="correo">
            </span>
            <div>
              <h6>Escríbenos</h6>
              <p>info@archistudio.com<br>proyectos@archistudio.com</p>
            </div>
          </li>

          <li>
            <span class="icon-wrapper">
              <img src={cellphone.src} alt="teléfono">
            </span>
            <div>
              <h6>Llámanos</h6>
              <p>+34 912 345 678<br>Lun - Vie, 9:00 - 18:00</p>
            </div>
          </li>
      </ul>
      <GoogleMap />
    </div>

    <div class="contact-form">
      <FormContact />
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--color-bg-light);
  }

  .contact-inner {
    max-width: var(--max-width);
    margin: auto;
    padding: 100px 40px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
  }

  .overline {
    display: inline-block;
    font-family: 'Inter Variable', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  h3 {
    font-family: 'Playfair Display Variable', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 32px;
  }

  ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 32px;
    list-style: none;
  }

  ul li {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 48px;
    background: var(--color-white);
    border-radius: 10px;
    box-shadow: var(--shadow-card);
    padding: 10px;
    flex-shrink: 0;
  }

  .icon-wrapper img {
    width: 22px;
    height: 22px;
  }

  h6 {
    font-family: 'Playfair Display Variable', serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  li p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .contact-form {
    background: var(--color-white);
    border-radius: var(--border-radius);
    padding: 36px;
    box-shadow: var(--shadow-card);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 768px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 60px 20px;
    }

    .contact-form {
      padding: 24px;
    }

    h3 {
      font-size: 1.6rem;
    }
  }
</style>
