const { project } = Astro.props
---

<Layout title={`${project.title} | FORMA`}>
  
  <ProjectHero
    title={project.title}
    location={project.location}
    year={project.year}
    image={project.image}
  />

  <ProjectInfo
    category={project.category}
    location={project.location.split(',')[0]}
    year={project.year}
    surface={project.surface}
    client={project.client}
    status={project.status}
  />

  <ProjectNarrative
    title={project.narrativeTitle}
    content={project.narrativeContent}
    quote={project.quote}
    materials={project.materials}
    team={project.team}
  />

  <ProjectGallery images={project.gallery} />

  <ProjectPlans plans={project.plans} />

  <ProjectRelated />
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
