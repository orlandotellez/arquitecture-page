<style>
  .projects {
    padding-top: 120px;
    padding-bottom: 120px;
    background-color: var(--color-surface-container-lowest);
  }

  .projects-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 48px;
  }

  .projects-label {
    font-family: var(--font-technical-data);
    font-size: 12px;
    color: var(--color-primary);
    display: block;
    margin-bottom: 12px;
  }

  .projects-title {
    font-family: var(--font-headline-md);
    font-size: 32px;
    line-height: 40px;
  }

  .projects-link {
    font-family: var(--font-label-caps);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-on-surface);
    position: relative;
    padding-bottom: 4px;
  }

  .projects-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -2px;
    left: 0;
    background-color: var(--color-primary);
    transition: width 0.3s ease-in-out;
  }

  .projects-link:hover::after {
    width: 100%;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-gutter);
  }

  @media (min-width: 769px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .project-card {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .project-image-wrapper {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .project-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform 0.6s ease;
  }

  .project-card:hover .project-image-wrapper img {
    transform: scale(1.05);
    filter: grayscale(0);
  }

  .project-info {
    padding: 0 4px;
  }

  .project-location {
    font-family: var(--font-technical-data);
    font-size: 10px;
    color: var(--color-primary);
    display: block;
    margin-bottom: 4px;
  }

  .project-name {
    font-family: var(--font-headline-sm);
    font-size: 20px;
    line-height: 28px;
    color: var(--color-on-surface);
    transition: color 0.3s ease;
  }

  .project-card:hover .project-name {
    color: var(--color-primary);
  }
</style>