---
import SectionContainer from '../../components/SectionContainer.astro'

interface Props {
  title: string
  content: string[]
  quote: string
  materials: string[]
  team: string[]
}

const { title, content, quote, materials, team } = Astro.props
---

<section class="project-narrative">
  <SectionContainer>
    <div class="narrative-main">
      <h2 class="narrative-title">{title}</h2>
      <div class="narrative-content">
        {content.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <blockquote>
          <p>"{quote}"</p>
        </blockquote>
      </div>
    </div>
    <div class="narrative-sidebar">
      <div class="sidebar-section">
        <span class="sidebar-label">MATERIALIDAD</span>
        <ul class="sidebar-list">
          {materials.map((material) => (
            <li>— {material}</li>
          ))}
        </ul>
      </div>
      <div class="sidebar-section">
        <span class="sidebar-label">EQUIPO DE DISEÑO</span>
        <ul class="sidebar-list">
          {team.map((member) => (
            <li>{member}</li>
          ))}
        </ul>
      </div>
      <button class="btn-download">DESCARGAR DOSSIER</button>
    </div>
  </SectionContainer>
</section>

<style>
  .project-narrative {
    padding-top: 160px;
    padding-bottom: 160px;
  }

  .narrative-main {
    display: flex;
    flex-direction: column;
    gap: 48px;
    margin-bottom: 64px;
  }

  @media (min-width: 769px) {
    .narrative-main {
      display: grid;
      grid-template-columns: 7fr 4fr;
      gap: var(--spacing-gutter);
      margin-bottom: 0;
    }
  }

  .narrative-title {
    font-family: var(--font-headline-md);
    font-size: 42px;
    line-height: 48px;
    color: var(--color-on-surface);
    max-width: 480px;
  }

  .narrative-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    font-family: var(--font-body-lg);
    font-size: 18px;
    line-height: 28px;
    color: var(--color-on-surface-variant);
    max-width: 720px;
  }

  @media (min-width: 769px) {
    .narrative-content {
      grid-column: 1 / 2;
    }
  }

  .narrative-content blockquote {
    border-left: 2px solid var(--color-primary);
    padding-left: 32px;
    margin: 16px 0;
  }

  .narrative-content blockquote p {
    font-family: var(--font-headline-sm);
    font-size: 24px;
    color: var(--color-primary);
    font-style: italic;
  }

  .narrative-sidebar {
    background-color: var(--color-surface-container-high);
    padding: 40px;
    border: 1px solid rgba(77, 70, 60, 0.3);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 769px) {
    .narrative-sidebar {
      grid-column: 2 / -1;
      grid-row: 1 / 3;
    }
  }

  .sidebar-label {
    font-family: var(--font-label-caps);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    display: block;
    margin-bottom: 16px;
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar-list li {
    font-family: var(--font-technical-data);
    font-size: 12px;
    color: var(--color-on-surface);
  }

  .btn-download {
    width: 100%;
    padding: 16px;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-family: var(--font-label-caps);
    font-size: 11px;
    letter-spacing: 0.2em;
    font-weight: 700;
    transition: all 0.3s ease;
  }

  .btn-download:hover {
    background-color: var(--color-primary);
    color: var(--color-background);
  }
</style>
