---
import SectionContainer from '../../components/SectionContainer.astro'

interface Plan {
  title: string
  subtitle: string
}

interface Props {
  plans: Plan[]
}

const { plans } = Astro.props
---

<section class="project-plans">
  <SectionContainer>
    <div class="plans-header">
      <div>
        <span class="plans-label">02 DOCUMENTACIÓN</span>
        <h3 class="plans-title">Planimetría Técnica</h3>
      </div>
      <div class="plans-scale">SC / 1:100</div>
    </div>
  </SectionContainer>
  <div class="plans-scroll">
    <SectionContainer class="plans-scroll-inner">
      {plans.map((plan, index) => (
        <div class="plan-card">
          <div class="plan-placeholder">
            <span class="plan-watermark">{plan.title}</span>
          </div>
          <div class="plan-info">
            <span>Lámina A-{String(index + 1).padStart(2, '0')}</span>
            <span>{plan.subtitle}</span>
          </div>
        </div>
      ))}
    </SectionContainer>
  </div>
</section>

<style>
  .project-plans {
    padding-top: 160px;
    padding-bottom: 160px;
    background-color: var(--color-surface-container-lowest);
    overflow: hidden;
  }

  .plans-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 80px;
  }

  .plans-label {
    font-family: var(--font-label-caps);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    display: block;
  }

  .plans-title {
    font-family: var(--font-headline-md);
    font-size: 42px;
    line-height: 48px;
    margin-top: 16px;
  }

  .plans-scale {
    font-family: var(--font-technical-data);
    font-size: 12px;
    color: var(--color-on-surface-variant);
  }

  .plans-scroll {
    overflow-x: auto;
  }

  .plans-scroll-inner {
    display: flex;
    gap: var(--spacing-gutter);
    padding-bottom: 40px;
  }

  .plans-scroll-inner::-webkit-scrollbar {
    display: none;
  }

  .plan-card {
    flex: 0 0 600px;
    aspect-ratio: 4/3;
    border: 1px solid rgba(77, 70, 60, 0.3);
    padding: 48px;
    background-color: rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .plan-placeholder {
    border-top: 1px solid rgba(77, 70, 60, 0.5);
    border-left: 1px solid rgba(77, 70, 60, 0.5);
    width: 100%;
    height: 100%;
    position: relative;
    opacity: 0.4;
  }

  .plan-watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-technical-data);
    font-size: 12px;
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    transform: rotate(-45deg);
  }

  .plan-info {
    margin-top: 32px;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-technical-data);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--color-primary);
  }
</style>
