<style>
  .projects-page {
    padding-top: 160px;
  }

  .projects-page-header {
    padding-bottom: 80px;
  }

  .page-label {
    font-family: var(--font-technical-data);
    font-size: 12px;
    color: var(--color-primary);
    display: block;
    margin-bottom: 16px;
  }

  .page-title {
    font-family: var(--font-headline-md);
    font-size: 42px;
    line-height: 48px;
  }

  .projects-page-grid {
    width: 100%;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    display: block;
    aspect-ratio: 16/9;
    cursor: pointer;
    margin-bottom: var(--spacing-gutter);
  }

  .project-card-offset {
    margin-top: 0;
  }

  @media (min-width: 769px) {
    .project-card-offset {
      margin-top: 96px;
    }
  }

  .project-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform 1s ease;
  }

  .project-card:hover img {
    transform: scale(1.05);
    filter: grayscale(0);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(21, 19, 16, 0.6);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 48px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .project-location {
    font-family: var(--font-technical-data);
    font-size: 12px;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .project-name {
    font-family: var(--font-headline-md);
    font-size: 42px;
    line-height: 48px;
    margin-bottom: 16px;
  }

  .project-desc {
    font-family: var(--font-body-md);
    font-size: 16px;
    max-width: 400px;
    margin-bottom: 24px;
  }

  .project-line {
    width: 48px;
    height: 1px;
    background-color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .project-name {
      font-size: 32px;
    }
  }
</style>
