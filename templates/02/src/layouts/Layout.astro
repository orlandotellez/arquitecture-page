---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html class="dark" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=DM+Sans:wght@400;500;700&family=Courier+Prime:wght@400;700&family=Cormorant+Garamond:ital,wght@1,400;1,600&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet" />
  </head>
  <body class="bg-background text-on-surface">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* ===== CSS Variables ===== */
  :root {
    --color-surface-container-high: #2c2926;
    --color-secondary: #e3c09f;
    --color-surface-dim: #151310;
    --color-on-secondary-fixed: #291803;
    --color-surface: #151310;
    --color-secondary-container: #5a4228;
    --color-outline-variant: #4d463c;
    --color-secondary-fixed: #ffddbb;
    --color-on-primary-fixed: #281901;
    --color-on-primary: #3f2d11;
    --color-surface-container-low: #1e1b18;
    --color-secondary-fixed-dim: #e3c09f;
    --color-inverse-primary: #715b3a;
    --color-on-secondary-container: #d0af8e;
    --color-primary-fixed-dim: #e0c29a;
    --color-tertiary-container: #a1adc6;
    --color-tertiary-fixed-dim: #bbc7e1;
    --color-surface-container-highest: #373431;
    --color-inverse-surface: #e8e1dc;
    --color-on-tertiary-container: #354156;
    --color-surface-variant: #373431;
    --color-on-tertiary: #253145;
    --color-tertiary: #bcc8e2;
    --color-inverse-on-surface: #33302d;
    --color-error-container: #93000a;
    --color-on-background: #e8e1dc;
    --color-primary-container: #c4a882;
    --color-on-error-container: #ffdad6;
    --color-primary: #e1c39b;
    --color-background: #151310;
    --color-on-tertiary-fixed-variant: #3b475c;
    --color-surface-bright: #3c3935;
    --color-surface-tint: #e0c29a;
    --color-on-tertiary-fixed: #0f1c2f;
    --color-on-primary-container: #513d1f;
    --color-surface-container-lowest: #100e0b;
    --color-on-secondary-fixed-variant: #5a4228;
    --color-on-error: #690005;
    --color-primary-fixed: #fddeb5;
    --color-on-primary-fixed-variant: #584325;
    --color-on-surface: #e8e1dc;
    --color-on-secondary: #412c14;
    --color-outline: #998f84;
    --color-surface-container: #221f1c;
    --color-error: #ffb4ab;
    --color-tertiary-fixed: #d7e3fd;
    --color-on-surface-variant: #d0c5b8;

    --spacing-margin-mobile: 24px;
    --spacing-margin-desktop: 0px;
    --spacing-unit: 8px;
    --spacing-gutter: 32px;

    --max-width: 1200px;

    --font-headline-sm: 'Libre Caslon Text', serif;
    --font-label-caps: 'DM Sans', sans-serif;
    --font-body-md: 'DM Sans', sans-serif;
    --font-display-lg-mobile: 'Libre Caslon Text', serif;
    --font-body-lg: 'DM Sans', sans-serif;
    --font-headline-md: 'Libre Caslon Text', serif;
    --font-display-lg: 'Libre Caslon Text', serif;
    --font-technical-data: 'Courier Prime', monospace;
  }

  /* ===== Reset & Base ===== */
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body-md);
    background-color: var(--color-background);
    color: var(--color-on-surface);
    cursor: none;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    text-decoration: none;
    color: inherit;
    transition: color 0.3s ease;
  }

  img {
    display: block;
    max-width: 100%;
  }

  ul, ol {
    list-style: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
  }

  input, textarea {
    font-family: inherit;
  }

  /* ===== Cursor ===== */
  .cursor-dot {
    width: 10px;
    height: 10px;
    background-color: var(--color-primary);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
  }

  .cursor-ring {
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-primary);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: width 0.3s, height 0.3s;
  }

  /* ===== Links ===== */
  .link-underline {
    position: relative;
  }

  .link-underline::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -2px;
    left: 0;
    background-color: var(--color-primary);
    transition: width 0.3s ease-in-out;
  }

  .link-underline:hover::after {
    width: 100%;
  }

  /* ===== Typography Classes ===== */
  .font-headline-sm {
    font-family: var(--font-headline-sm);
    font-size: 24px;
    line-height: 32px;
    font-weight: 400;
  }

  .font-label-caps {
    font-family: var(--font-label-caps);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.2em;
    font-weight: 700;
  }

  .font-body-md {
    font-family: var(--font-body-md);
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }

  .font-body-lg {
    font-family: var(--font-body-lg);
    font-size: 18px;
    line-height: 28px;
    font-weight: 400;
  }

  .font-headline-md {
    font-family: var(--font-headline-md);
    font-size: 42px;
    line-height: 48px;
    font-weight: 400;
  }

  .font-display-lg {
    font-family: var(--font-display-lg);
    font-size: 84px;
    line-height: 92px;
    letter-spacing: -0.02em;
    font-weight: 400;
  }

  .font-technical-data {
    font-family: var(--font-technical-data);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.1em;
    font-weight: 400;
  }

  /* ===== Responsive Typography ===== */
  @media (max-width: 768px) {
    .font-display-lg {
      font-size: 48px;
      line-height: 52px;
    }
    .font-headline-md {
      font-size: 32px;
      line-height: 40px;
    }
  }

  /* ===== Cormorant Italic ===== */
  .cormorant-italic {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
  }

  /* ===== Scrollbar ===== */
  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-background);
  }

  ::-webkit-scrollbar-thumb {
    background: #332c26;
  }

  /* ===== Marquee Animation ===== */
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .animate-marquee {
    animation: marquee 30s linear infinite;
  }

  /* ===== Masonry Hover ===== */
  .masonry-item:hover img {
    transform: scale(1.05);
  }

  /* ===== Form Styles ===== */
  input, textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-outline-variant);
    padding: 16px 0;
    color: var(--color-on-surface);
    width: 100%;
    transition: border-color 0.3s ease;
  }

  input:focus, textarea:focus {
    outline: none;
    border-bottom-color: var(--color-primary);
  }

  input::placeholder, textarea::placeholder {
    color: var(--color-on-surface-variant);
  }

  /* ===== Spacing Utilities ===== */
  .px-margin-mobile {
    padding-left: var(--spacing-margin-mobile);
    padding-right: var(--spacing-margin-mobile);
  }

  .px-margin-desktop {
    padding-left: var(--spacing-margin-desktop);
    padding-right: var(--spacing-margin-desktop);
  }

  .py-unit {
    padding-top: var(--spacing-unit);
    padding-bottom: var(--spacing-unit);
  }

  .gap-gutter {
    gap: var(--spacing-gutter);
  }

  @media (max-width: 768px) {
    .px-margin-mobile, .px-margin-desktop {
      padding-left: var(--spacing-margin-mobile);
      padding-right: var(--spacing-margin-mobile);
    }
  }

  @media (min-width: 769px) {
    .px-margin-mobile {
      padding-left: var(--spacing-margin-desktop);
      padding-right: var(--spacing-margin-desktop);
    }
  }

  /* ===== Container ===== */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-left: var(--spacing-margin-mobile);
    padding-right: var(--spacing-margin-mobile);
  }

  @media (min-width: 769px) {
    .container {
      padding-left: var(--spacing-margin-desktop);
      padding-right: var(--spacing-margin-desktop);
    }
  }
</style>
