---
interface Props {
  id: string;
  name: string;
  description: string;
  stack: string[];
  githubUrl: string;
  liveUrl: string;
  index: number;
}

const { id, name, description, stack, githubUrl, liveUrl, index } = Astro.props;
---

<article
  class="template-card card reveal"
  style={`--delay: ${index * 0.05}s`}
>
  <div class="card-preview">
    <div class="preview-placeholder">
      <div class="preview-ui">
        <div class="ui-header"></div>
        <div class="ui-body">
          <div class="ui-hero"></div>
          <div class="ui-rows">
            <div class="ui-row"></div>
            <div class="ui-row"></div>
            <div class="ui-row"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-body">
    <span class="card-id mono">{id}</span>
    <h3 class="card-title">{name}</h3>
    <p class="card-description">{description}</p>

    <div class="card-tags">
      {stack.slice(0, 4).map(tech => (
        <span class="tag">{tech}</span>
      ))}
    </div>

    <div class="card-footer">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener"
        class="card-github"
        aria-label="Ver en GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href={liveUrl} target="_blank" rel="noopener" class="card-link">
        VER PLANTILLA →
      </a>
    </div>
  </div>
</article>

<style>
  .template-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .template-card:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 149, 108, 0.3);
  }

  .template-card.hidden {
    display: none;
  }

  .card-preview {
    height: 240px;
    overflow: hidden;
    background-color: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
  }

  .preview-placeholder {
    width: 100%;
    height: 100%;
    padding: 16px;
  }

  .preview-ui {
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-secondary);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .template-card:hover .preview-ui {
    transform: scale(1.02);
  }

  .ui-header {
    height: 32px;
    background-color: var(--color-bg-nav);
    border-bottom: 1px solid var(--color-border);
  }

  .ui-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: calc(100% - 32px);
  }

  .ui-hero {
    height: 60%;
    background: linear-gradient(180deg, var(--color-bg-elevated) 0%, transparent 100%);
    border-radius: 4px;
    position: relative;
  }

  .ui-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(90deg, var(--color-coffee-500) 0%, transparent 50%);
    opacity: 0.4;
  }

  .ui-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ui-row {
    height: 12px;
    background-color: var(--color-bg-elevated);
    border-radius: 4px;
  }

  .card-body {
    padding: 24px;
  }

  .card-id {
    font-size: 11px;
    color: var(--color-coffee-400);
    display: block;
    margin-bottom: 8px;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .card-description {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-github {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .card-github:hover {
    color: var(--color-text);
  }

  .card-link {
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .card-link:hover {
    color: var(--color-coffee-400);
  }
</style>
