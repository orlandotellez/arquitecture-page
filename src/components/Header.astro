---
---

<header>
  <div class="container">
    <a href="/" class="logo">
      <h1>ARCHISTUDIO</h1>
    </a>

    <nav>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
        <li><a href="/proyectos">Proyectos</a></li>
        <li><a href="/servicios">Servicios</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: fixed;
    background-color: var(--color-white);
    width: 100%;
    top: 0;
    padding: 18px 40px;
    z-index: 1000;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.05);
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: auto;
    max-width: var(--max-width);
  }

  .logo h1 {
    font-family: 'Playfair Display Variable', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.04em;
  }

  nav {
    display: flex;
    align-items: center;
  }

  ul {
    display: flex;
    gap: 32px;
  }

  a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-dark);
    position: relative;
    padding-bottom: 4px;
  }

  a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition: width 0.3s ease;
  }

  a:hover::after {
    width: 100%;
  }

  a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    header {
      padding: 14px 20px;
    }

    ul {
      gap: 16px;
    }

    a {
      font-size: 0.85rem;
    }

    .logo h1 {
      font-size: 1.4rem;
    }
  }
</style>
