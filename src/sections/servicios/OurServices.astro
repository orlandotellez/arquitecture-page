---
import first_service from '../../assets/first_service.svg';
import second_service from '../../assets/second_service.svg';
import third_service from '../../assets/third_service.svg';
import four_service from '../../assets/four_service.svg';
---

<section class="services-section">
  <div class="services-inner">
    <div class="services-header">
      <span class="overline">Nuestras áreas</span>
      <h3>Lo que hacemos</h3>
    </div>
    <ul class="services-grid">
      <li class="service-card">
        <span class="icon-wrapper">
          <img src={first_service.src} alt="Diseño arquitectónico">
        </span>
        <div class="service-content">
          <h6>Diseño arquitectónico</h6>
          <p>Desarrollamos proyectos integrales desde la conceptualización hasta la ejecución, enfocados en la funcionalidad y la estética atemporal.</p>
        </div>
      </li>

      <li class="service-card">
        <span class="icon-wrapper">
          <img src={second_service.src} alt="Urbanismo">
        </span>
        <div class="service-content">
          <h6>Urbanismo</h6>
          <p>Planificación y diseño de espacios urbanos que mejoran la calidad de vida y fomentan la sostenibilidad en las ciudades.</p>
        </div>
      </li>

      <li class="service-card">
        <span class="icon-wrapper">
          <img src={third_service.src} alt="Interiorismo">
        </span>
        <div class="service-content">
          <h6>Interiorismo</h6>
          <p>Creación de atmósferas interiores que dialogan con la arquitectura y reflejan la identidad de quienes las habitan.</p>
        </div>
      </li>

      <li class="service-card">
        <span class="icon-wrapper">
          <img src={four_service.src} alt="Consultoría">
        </span>
        <div class="service-content">
          <h6>Consultoría</h6>
          <p>Acompañamiento experto en cada fase del proyecto, desde la viabilidad técnica hasta la optimización de recursos y plazos.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--color-bg-light);
  }

  .services-inner {
    max-width: var(--max-width);
    margin: auto;
    padding: 100px 40px;
  }

  .services-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .overline {
    display: inline-block;
    font-family: 'Inter Variable', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  h3 {
    font-family: 'Playfair Display Variable', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    list-style: none;
  }

  .service-card {
    background: var(--color-white);
    border-radius: var(--border-radius);
    padding: 32px 28px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
    box-shadow: var(--shadow-card);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: var(--transition);
  }

  .service-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-4px);
    border-color: var(--color-accent-light);
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--color-accent-light), var(--color-accent));
    border-radius: 12px;
    flex-shrink: 0;
  }

  .icon-wrapper img {
    width: 26px;
    height: 26px;
    filter: invert(1);
  }

  .service-content h6 {
    font-family: 'Playfair Display Variable', serif;
    font-size: 1.1rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .service-content p {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .services-inner {
      padding: 60px 20px;
    }

    h3 {
      font-size: 1.6rem;
    }
  }
</style>
