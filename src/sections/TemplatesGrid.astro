---
import { templates, categories } from '../data/templates.js';
import TemplateCard from '../components/TemplateCard.astro';
---

<section id="plantillas" class="templates section">
  <div class="container">
    <div class="templates-header reveal">
      <div class="header-left">
        <span class="header-label mono">PLANTILLAS</span>
        <h2 class="header-title">Templates desarrollados.</h2>
      </div>

      <div class="header-filters">
        {categories.map(cat => (
          <button
            class="filter-btn mono"
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <div class="templates-grid">
      {templates.map((template, index) => (
        <TemplateCard
          id={template.id}
          name={template.name}
          description={template.description}
          stack={template.stack}
          githubUrl={template.githubUrl}
          liveUrl={template.liveUrl}
          index={index}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .templates {
    background-color: var(--color-bg);
  }

  .templates-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 64px;
    gap: 32px;
  }

  .header-label {
    font-size: 10px;
    color: var(--color-coffee-400);
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: 12px;
  }

  .header-title {
    font-size: 52px;
    color: var(--color-text);
  }

  .header-filters {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 8px 16px;
    background: none;
    border: none;
    font-size: 11px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .filter-btn:hover {
    color: var(--color-text-secondary);
  }

  .filter-btn.active {
    color: var(--color-text);
  }

  .filter-btn.active::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 8px;
    right: 8px;
    height: 2px;
    background-color: var(--color-coffee-400);
  }

  .templates-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
  }

  @media (max-width: 1024px) {
    .templates-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .templates-header {
      flex-direction: column;
    }

    .header-title {
      font-size: 36px;
    }

    .header-filters {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 8px;
    }

    .filter-btn {
      white-space: nowrap;
    }

    .templates-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.template-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const category = btn.dataset.category;

      cards.forEach(card => {
        if (category === 'todos') {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Set first button as active
  filterBtns[0]?.classList.add('active');
</script>
