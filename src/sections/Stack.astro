---
import { techStack } from '../data/templates.js';
---

<section id="stack" class="stack section-alt">
  <div class="container">
    <div class="stack-header reveal">
      <span class="stack-label mono">STACK</span>
      <h2 class="stack-title">Mi stack técnico.</h2>
    </div>

    <div class="stack-grid">
      {techStack.map((tech, index) => (
        <div class="tech-card reveal" style={`--delay: ${index * 0.05}s`}>
          <div class="tech-icon">
            {tech.name === 'Astro' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            )}
            {tech.name === 'CSS' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            )}
            {tech.name === 'TypeScript' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15.75h7.5" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 11.25v9" />
              </svg>
            )}
            {tech.name === 'Node' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.115 5.19l.319 1.913A6 6 0 008.11 10.36L9.75 12l-.387.775c-.217.433-.132.956.21 1.298l1.348 1.348c.21.21.329.497.329.795v1.089c0 .426.24.815.622 1.006l.153.076c.433.217.956.132 1.298-.21l.723-.723a8.7 8.7 0 002.288-4.042 1.087 1.087 0 00-.358-1.099l-1.33-1.108c-.251-.21-.394-.516-.394-.842v-1.7c0-.663-.48-1.218-1.117-1.374a5.256 5.256 0 01-3.453-4.124l-.34-2.04a5.019 5.019 0 00-1.663-2.621A4.5 4.5 0 005.5 2.5H4.626c-.887 0-1.683.511-2.068 1.302l-.543 1.116a2.25 2.25 0 00.137 2.15l2.14 3.327" />
              </svg>
            )}
            {tech.name === 'HTML' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
            )}
            {tech.name === 'JavaScript' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3 3 0 013 3v2.25a3 3 0 01-3 3M3.75 6.75a3 3 0 00-3 3v2.25a3 3 0 003 3" />
              </svg>
            )}
          </div>
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack {
    background-color: var(--color-bg-nav);
    padding: 80px 0;
  }

  .stack-header {
    margin-bottom: 64px;
  }

  .stack-label {
    font-size: 10px;
    color: var(--color-text-muted);
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: 12px;
  }

  .stack-title {
    font-size: 52px;
    color: var(--color-text);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter);
  }

  .tech-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    cursor: default;
    transition: border-color 0.2s ease;
  }

  .tech-card:hover {
    border-color: var(--color-coffee-400);
  }

  .tech-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech-icon svg {
    width: 32px;
    height: 32px;
    color: var(--color-text-secondary);
  }

  .tech-name {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stack-title {
      font-size: 36px;
    }

    .stack-grid {
      grid-template-columns: 1fr;
    }

    .tech-card {
      padding: 16px 20px;
    }
  }
</style>
