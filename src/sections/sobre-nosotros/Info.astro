---
import OurHistory from '../../components/OurHistory.astro';
import Values from '../../components/Values.astro'
---

<section class="info-section">
  <div class="info-grid">
    <div class="history-col">
      <OurHistory />
    </div>
    <div class="values-col">
      <Values />
    </div>
  </div>
</section>

<style>
  .info-section {
    background-color: var(--color-bg-light);
    width: 100%;
  }

  .info-grid {
    max-width: var(--max-width);
    margin: auto;
    padding: 100px 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 60px 20px;
    }

    .history-col {
      order: -1;
    }
  }
</style>
