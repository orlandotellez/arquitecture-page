---
import { Zap, Wrench, Heart } from '@lucide/astro';

const features = [
  {
    icon: Zap,
    title: 'Listo para usar',
    description: 'Plantillas probadas y optimizadas para producción',
    color: 'coffee'
  },
  {
    icon: Wrench,
    title: 'Personalizable',
    description: 'Modifica y adapta cada plantilla a tus necesidades',
    color: 'amber'
  },
  {
    icon: Heart,
    title: 'Open Source',
    description: 'Totalmente gratuito y de código abierto',
    color: 'orange'
  }
];
---

<section class="features">
  <div class="features-inner">
    <div class="features-grid">
      {features.map(feature => (
        <div class="feature">
          <div class={`feature-icon feature-icon-${feature.color}`}>
            <feature.icon size={24} />
          </div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-description">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 64px 24px;
    border-top: 1px solid var(--color-border);
  }

  .features-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature {
    text-align: center;
  }

  @media (min-width: 768px) {
    .feature {
      text-align: left;
    }
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin: 0 auto 16px;
  }

  @media (min-width: 768px) {
    .feature-icon {
      margin: 0 0 16px 0;
    }
  }

  .feature-icon-coffee {
    background: rgba(184, 133, 90, 0.2);
  }

  .feature-icon-amber {
    background: rgba(251, 191, 36, 0.2);
  }

  .feature-icon-orange {
    background: rgba(251, 146, 60, 0.2);
  }

  .feature-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .feature-description {
    font-size: 14px;
    color: var(--color-text-muted);
  }
</style>
